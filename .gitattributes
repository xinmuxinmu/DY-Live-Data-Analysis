# 让源码在仓库里统一用 LF，避免 Windows 上 autocrlf 把全部文件刷成 CRLF
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制不参与换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.flv binary
*.m4a binary
*.zip binary
*.7z binary
